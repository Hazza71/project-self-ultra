# Project Self Ultra (PSX) — environment
# Copy to .env (repo root) and apps/mobile/.env as needed.

# --- Auth / database (Supabase) ---
# Leave empty to run the mobile app against the local in-memory store
# (canonical catalog + per-device progress). Schema/migrations/RLS in
# supabase/ are ready to apply when you have a project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is SERVER ONLY — never put this in the mobile app.
# Used by scripts/seed-postgres.mjs when seeding the catalog.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL (Supabase or local docker-compose)
# Example local: postgres://psx:psx@localhost:54322/psx
DATABASE_URL=

# Local docker-compose postgres (see docker-compose.yml)
POSTGRES_USER=psx
POSTGRES_PASSWORD=psx
POSTGRES_DB=psx
POSTGRES_PORT=54322

# Optional: override catalog path (defaults to data/canonical_data.json)
PSX_CANONICAL_DATA_PATH=
